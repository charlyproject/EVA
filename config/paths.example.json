    "notepad": {
      "name": "Notepad",
      "path": "C:\\Windows\\System32\\notepad.exe",
      "keywords": ["notepad", "bloc de notas"]
    }
  },
  "custom_folders": {
    "documentos": {
      "name": "Documentos",
      "path": "%USERPROFILE%\\Documents",
      "keywords": ["documentos", "documents"]
    }
  },
  "custom_websites": {
    "youtube": {
      "name": "YouTube",
      "url": "https://www.youtube.com",
      "keywords": ["youtube", "videos"]
    }
  },
  "custom_hotkeys": [
    {
      "name": "Activar EVA",
      "combination": "ctrl+alt+e",
      "action": "activate_eva"
    }
  ],
  "managed_paths": {
    "program_chrome": {
      "path_type": "program",
      "relative_path": "chrome.exe",
      "fallback_paths": [
        "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"
      ],
      "platform_specific": {
        "windows": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "linux": "/usr/bin/google-chrome",
        "darwin": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      },
      "validate_exists": false,
      "description": "Google Chrome browser"
    },
    "program_vlc": {
      "path_type": "program",
      "relative_path": "vlc.exe",
      "fallback_paths": [
        "C:\\Program Files\\VideoLAN\\VLC\\vlc.exe",
        "C:\\Program Files (x86)\\VideoLAN\\VLC\\vlc.exe"
      ],
      "platform_specific": {
        "windows": "C:\\Program Files\\VideoLAN\\VLC\\vlc.exe",
        "linux": "/usr/bin/vlc",
        "darwin": "/Applications/VLC.app/Contents/MacOS/VLC"
      },
      "validate_exists": false,
      "description": "VLC Media Player"
    },
    "program_ollama": {
      "path_type": "program",
      "relative_path": "ollama.exe",
      "fallback_paths": [
        "C:\\Program Files\\Ollama\\ollama.exe",
        "%USERPROFILE%\\AppData\\Local\\Programs\\Ollama\\ollama.exe",
        "C:\\ProgramData\\chocolatey\\bin\\ollama.exe"
      ],
      "platform_specific": {
        "windows": "C:\\Program Files\\Ollama\\ollama.exe",
        "linux": "/usr/bin/ollama",
        "darwin": "/usr/local/bin/ollama"
      },
      "validate_exists": true,
      "description": "Ollama local LLM executable"
    },
    "ffmpeg_bin": {
      "path_type": "program",
      "relative_path": "ffmpeg/bin/ffmpeg.exe",
      "fallback_paths": [
        "./ffmpeg/bin",
        "C:\\ffmpeg\\bin",
        "D:\\ffmpeg\\bin",
        "_internal/ffmpeg/bin"
      ],
      "platform_specific": {
        "windows": "ffmpeg/bin/ffmpeg.exe",
        "linux": "ffmpeg/bin/ffmpeg",
        "darwin": "ffmpeg/bin/ffmpeg"
      },
      "validate_exists": false,
      "description": "FFmpeg executable"
    },
    "vosk_models": {
      "path_type": "model",
      "relative_path": "models/vosk",
      "fallback_paths": [
        "%USERPROFILE%\\AppData\\Local\\EVA\\models\\vosk",
        "C:\\vosk",
        "D:\\vosk",
        "./vosk",
        "_internal/vosk"
      ],
      "create_if_missing": false,
      "description": "Vosk speech recognition models directory"
    },
    "tts_voices": {
      "path_type": "voice",
      "relative_path": "piper/espeak-ng-data/voices",
      "fallback_paths": ["./piper/espeak-ng-data/voices", "_internal/piper/espeak-ng-data/voices"],
      "create_if_missing": false,
      "description": "Piper TTS voice models directory"
    },
    "user_downloads": {
      "path_type": "user_folder",
      "relative_path": "Downloads",
      "platform_specific": {
        "windows": "%USERPROFILE%\\Downloads",
        "linux": "~/Downloads",
        "darwin": "~/Downloads"
      },
      "description": "User downloads folder"
    },
    "user_documents": {
      "path_type": "user_folder",
      "relative_path": "Documents",
      "platform_specific": {
        "windows": "%USERPROFILE%\\Documents",
        "linux": "~/Documents",
        "darwin": "~/Documents"
      },
      "description": "User documents folder"
    },
    "websites": {
      "google": "https://www.google.com",
      "github": "https://github.com",
      "youtube": "https://www.youtube.com",
      "twitch": "https://www.twitch.tv"
